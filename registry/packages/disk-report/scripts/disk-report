#!/usr/bin/env bash
#
# disk-report —— 磁盘占用排查：目录汇总 / 最大文件 / 扩展名统计。
#
# 只读工具：只用 du / find / sort / awk（GNU coreutils + findutils），
# 不写任何文件、不联网、不需要 root。
#
# 退出码：0 正常；1 运行出错（目录不存在、参数非法）；2 用法不对。
set -euo pipefail

export LC_ALL=C

PROG="${0##*/}"
VERSION="1.0.0"

usage() {
    cat <<EOF
用法: $PROG <子命令> [选项]

看看磁盘上到底是什么东西占了地方。全部只读，不写文件、不联网、不需要 root。

子命令:
  dirs     按目录汇总占用 —— 「这个目录里谁最占地方」
  files    找出最大的那些文件
  ext      按扩展名统计：文件数 / 总大小 / 占比

通用:
  -h, --help      显示这份帮助
  -V, --version   显示版本

各子命令的选项:
  $PROG dirs  [--path 目录] [--depth 0-9] [--top N]
  $PROG files [--path 目录] [--depth 0-9|all] [--top N] [--min-size 字节]
  $PROG ext   [--path 目录] [--depth 0-9|all] [--top N]

  --path      从哪个目录开始（默认 .）
  --depth     dirs 默认 1；files / ext 默认 3；可以写 all 表示不限制
  --top       只打印前 N 项（默认 20），其余只计入合计
  --min-size  files 用：小于这个字节数的文件直接忽略（默认 0）

示例:
  $PROG dirs  --path . --depth 1 --top 10
  $PROG files --path ~/下载 --depth 2 --top 20 --min-size 10485760
  $PROG ext   --path . --depth 3 --top 15

大小一律换算成 KiB / MiB / GiB 打印，但排序用的是真实字节数，
所以 9 MiB 排在 10 MiB 后面，不会因为单位不同而乱序。

默认不跨文件系统（du -x / find -xdev）：扫 / 的时候不会一头扎进
/mnt 上挂着的移动硬盘。起点自己如果就是挂载点，照常扫描。
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; printf '%s: 用 -h 看用法\n' "$PROG" >&2; exit 1; }
bad_usage() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 2; }

# 拼进每个 awk 程序里的大小换算函数（输入字节，输出人类可读）。
HUMAN='
function human(b,   u, i) {
    split("B KiB MiB GiB TiB PiB", u, " ")
    i = 1
    while (b >= 1024 && i < 6) { b /= 1024; i++ }
    if (i == 1) return sprintf("%d B", b)
    return sprintf("%.1f %s", b, u[i])
}
'

need_dir() { [ -d "$1" ] || die "「$1」不是目录"; }

check_uint() { # 名字 值
    case "$2" in ''|*[!0-9]*) die "$1 得是 0 以上的整数，收到「$2」" ;; esac
}

maxdepth_arg() { # 深度 → find 的 -maxdepth 片段（all / 0 表示不限制）
    case "$1" in
        all) printf '' ;;
        *)   printf '%s %s' '-maxdepth' "$1" ;;
    esac
}

# ── dirs：按目录汇总 ────────────────────────────────────────────────────────

cmd_dirs() {
    local path="." depth="1" top="20"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --path) [ "$#" -ge 2 ] || bad_usage "dirs: --path 后面要跟目录"; path="$2"; shift 2 ;;
            --depth) [ "$#" -ge 2 ] || bad_usage "dirs: --depth 后面要跟数字"; depth="$2"; shift 2 ;;
            --top) [ "$#" -ge 2 ] || bad_usage "dirs: --top 后面要跟数字"; top="$2"; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            *) bad_usage "dirs: 不认识的参数「$1」" ;;
        esac
    done
    check_uint --depth "$depth"
    check_uint --top "$top"
    [ "$top" -gt 0 ] || die "--top 得大于 0"
    need_dir "$path"

    printf '目录占用  %s  （深度 %s，前 %s 项）\n\n' "$path" "$depth" "$top"
    # du 的权限报错照旧走 stderr；退出码忽略，好让 report 在普通用户下也能跑完。
    { du -x -B1 --max-depth="$depth" -- "$path" 2>/dev/null || true; } \
        | sort -t"$(printf '\t')" -k1,1nr \
        | awk -F'\t' -v n="$top" "$HUMAN"'
            NR <= n { printf "%12s  %s\n", human($1), $2 }
            { total += $1 }
            END {
                printf "\n%12s  %d 项合计（含未列出的）\n", human(total), NR
            }'
}

# ── files：最大的文件 ──────────────────────────────────────────────────────

cmd_files() {
    local path="." depth="3" top="20" min_size="0"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --path) [ "$#" -ge 2 ] || bad_usage "files: --path 后面要跟目录"; path="$2"; shift 2 ;;
            --depth) [ "$#" -ge 2 ] || bad_usage "files: --depth 后面要跟数字或 all"; depth="$2"; shift 2 ;;
            --top) [ "$#" -ge 2 ] || bad_usage "files: --top 后面要跟数字"; top="$2"; shift 2 ;;
            --min-size) [ "$#" -ge 2 ] || bad_usage "files: --min-size 后面要跟字节数"; min_size="$2"; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            *) bad_usage "files: 不认识的参数「$1」" ;;
        esac
    done
    case "$depth" in all) ;; *) check_uint --depth "$depth" ;; esac
    check_uint --top "$top"
    check_uint --min-size "$min_size"
    [ "$top" -gt 0 ] || die "--top 得大于 0"
    need_dir "$path"

    printf '最大的文件  %s  （深度 %s，前 %s 个，≥ %s 字节）\n\n' \
        "$path" "$depth" "$top" "$min_size"

    { find "$path" -xdev $(maxdepth_arg "$depth") -type f -printf '%s\t%p\n' 2>/dev/null || true; } \
        | sort -t"$(printf '\t')" -k1,1nr \
        | awk -F'\t' -v n="$top" -v min="$min_size" "$HUMAN"'
            $1 < min { next }
            { files++; total += $1 }
            shown < n { printf "%12s  %s\n", human($1), $2; shown++ }
            END {
                if (files == 0) {
                    printf "没有找到符合条件的文件（换个 --path / --depth，或把 --min-size 调小）\n"
                    exit 0
                }
                printf "\n%12s  %d 个文件合计\n", human(total), files
            }'
}

# ── ext：按扩展名统计 ──────────────────────────────────────────────────────

cmd_ext() {
    local path="." depth="3" top="20"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --path) [ "$#" -ge 2 ] || bad_usage "ext: --path 后面要跟目录"; path="$2"; shift 2 ;;
            --depth) [ "$#" -ge 2 ] || bad_usage "ext: --depth 后面要跟数字或 all"; depth="$2"; shift 2 ;;
            --top) [ "$#" -ge 2 ] || bad_usage "ext: --top 后面要跟数字"; top="$2"; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            *) bad_usage "ext: 不认识的参数「$1」" ;;
        esac
    done
    case "$depth" in all) ;; *) check_uint --depth "$depth" ;; esac
    check_uint --top "$top"
    [ "$top" -gt 0 ] || die "--top 得大于 0"
    need_dir "$path"

    printf '按扩展名统计  %s  （深度 %s，前 %s 项）\n\n' "$path" "$depth" "$top"
    printf '%s\n\n' '扩展名           文件数        总大小   占比'

    { find "$path" -xdev $(maxdepth_arg "$depth") -type f -printf '%s\t%f\n' 2>/dev/null || true; } \
        | awk -F'\t' '
            {
                name = $2
                ext = "(none)"
                if (name ~ /\./ && name !~ /^\.+$/) {
                    ext = name
                    sub(/^.*\./, "", ext)
                    if (ext == "") ext = "(none)"
                    else ext = tolower(ext)
                }
                count[ext]++
                size[ext] += $1
            }
            END { for (e in count) printf "%s\t%d\t%d\n", e, count[e], size[e] }
        ' \
        | sort -t"$(printf '\t')" -k3,3nr \
        | awk -F'\t' -v n="$top" "$HUMAN"'
            { e[NR] = $1; c[NR] = $2; s[NR] = $3; total += $3; files += $2 }
            END {
                for (i = 1; i <= NR && i <= n; i++) {
                    share = total ? s[i] * 100 / total : 0
                    printf "%-14s %8d  %12s  %5.1f%%\n", e[i], c[i], human(s[i]), share
                }
                if (NR > n) printf "... 还有 %d 种没列出\n", NR - n
                printf "\n合计：%d 个文件，%s\n", files, human(total)
            }'
}

# ── 分发 ────────────────────────────────────────────────────────────────────

[ "$#" -gt 0 ] || { usage >&2; exit 2; }

command="$1"
shift
case "$command" in
    dirs)  cmd_dirs  "$@" ;;
    files) cmd_files "$@" ;;
    ext)   cmd_ext   "$@" ;;
    -h|--help|help) usage; exit 0 ;;
    -V|--version|version) printf '%s %s\n' "$PROG" "$VERSION"; exit 0 ;;
    *) bad_usage "不认识的子命令「$command」（可用 dirs / files / ext）" ;;
esac
