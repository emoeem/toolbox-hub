# toolbox-hub 的 PKGBUILD。
#
# 这个文件**现在就能用**：它从仓库根目录打包（见 packaging/make-source-tarball.sh），
# 不依赖任何还没发布的远端。等仓库推到公开地址之后，把 source 与 sha256sums
# 换成 URL 那一套就能交 AUR（步骤见 packaging/README.md）。
#
# 维护者: emoeem <3353745917@qq.com>

pkgname=toolbox-hub
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux CLI 工具箱：工具发现 + 表单执行 + 原生包管理（直连 libalpm）"
arch=('x86_64' 'aarch64')
url="https://github.com/emoeem/toolbox-hub"
# TODO: 仓库里还没有 LICENSE 文件。定了许可证之后把这里改掉，
# 并把 LICENSE 提交进去 —— AUR 要求许可证字段是真实有效的。
license=('unknown')
# 为什么只写 pacman：二进制直接链接了 libalpm.so，而 libalpm 自己的依赖
# （libarchive / openssl / curl / gpgme / brotli / bzip2 / acl …）都由 pacman 包
# 声明并安装。同理 gcc-libs 提供 libgcc_s。
# chafa：二进制**动态链接** libchafa.so.0（ldd 可见），所以是运行期依赖；
# 它同时提供 chafa.pc，构建期 ratatui-image 的 build.rs 也要用它探测版本 >= 1.8.0。
depends=('glibc' 'gcc-libs' 'pacman' 'chafa')
makedepends=('cargo' 'rust' 'pkgconf')
optdepends=(
  'paru: 搜索与安装 AUR 包'
  'pacman-contrib: 清理缓存与检查更新'
  'yazi: 浏览文件并选择输入路径'
  'ffmpeg: 媒体转换与媒体工具动作'
  'yt-dlp: 视频下载动作'
  'imagemagick: 图像处理动作'
  'perl-image-exiftool: 查看与编辑媒体元数据'
  '7zip: 归档创建、解压与完整性测试'
  'jq: JSON 查询动作'
  'pandoc: 文档转换动作'
  'aria2: 多连接下载动作'
  'pciutils: 查看 PCI 设备与驱动'
  'sing-box: 本机代理运维动作'
  'wl-clipboard: Wayland 剪贴板复制'
  'xclip: X11 剪贴板复制'
)
# options：不生成 debug 包（Rust 的调试符号很大，对使用者没用）。
options=('!debug')
# 本地打包：tarball 由 make-source-tarball.sh 生成在旁边，所以校验和写 SKIP。
# 发布到 AUR 时换成 URL + 真实 sha256sums（makepkg -g >> PKGBUILD）。
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"

  # makepkg 默认给 CFLAGS 带上 `-flto=auto -ffat-lto-objects`（那是给 C/C++ 项目
  # 准备的），而 ureq 的 TLS 后端 `ring` 里有一段汇编：在这两个选项下链接会缺
  #   undefined symbol: ring_core_0_17_14__bn_neg_inv_mod_r_u64  …
  # 这类符号。Rust 这边不需要它们（cargo 自己管优化），所以本地去掉。
  # 这是**实拍**踩出来的：`makepkg -f` 第一次跑就是这么失败的。
  export CFLAGS="${CFLAGS//-ffat-lto-objects/}"
  export CFLAGS="${CFLAGS//-flto=auto/}"

  # --locked：用仓库里的 Cargo.lock 构建，避免“在我机器上是好的”。
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  # 项目的三道门之一。想跳过用 makepkg --nocheck。
  cargo test --locked
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 packaging/toolbox-hub.1 \
    "$pkgdir/usr/share/man/man1/toolbox-hub.1"
  install -Dm644 completions/toolbox-hub.fish \
    "$pkgdir/usr/share/fish/vendor_completions.d/toolbox-hub.fish"

  # sing-box 那 5 个内置动作真正执行的脚本（manifests/sing-box.toml）。
  # manifest 的 program 写的是**裸命令名**、走 PATH 解析，所以必须放在 PATH 上的目录：
  # 放 /usr/bin 而不是 /usr/local/bin —— 后者是留给用户自己覆盖系统文件的地方。
  install -m755 scripts/sing-box/sing-box-* "$pkgdir/usr/bin/"

  # 许可证文件还没进仓库，有 LICENSE 之后取消注释
  # install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
