pkgbase = toolbox-hub
	pkgdesc = Linux CLI 工具箱：工具发现 + 表单执行 + 原生包管理（直连 libalpm）
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/emoeem/toolbox-hub
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = rust
	makedepends = pkgconf
	depends = glibc
	depends = gcc-libs
	depends = pacman
	depends = chafa
	optdepends = paru: 搜索与安装 AUR 包
	optdepends = pacman-contrib: 清理缓存与检查更新
	optdepends = yazi: 浏览文件并选择输入路径
	optdepends = ffmpeg: 媒体转换与媒体工具动作
	optdepends = yt-dlp: 视频下载动作
	optdepends = imagemagick: 图像处理动作
	optdepends = perl-image-exiftool: 查看与编辑媒体元数据
	optdepends = 7zip: 归档创建、解压与完整性测试
	optdepends = jq: JSON 查询动作
	optdepends = pandoc: 文档转换动作
	optdepends = aria2: 多连接下载动作
	optdepends = pciutils: 查看 PCI 设备与驱动
	optdepends = sing-box: 本机代理运维动作
	optdepends = wl-clipboard: Wayland 剪贴板复制
	optdepends = xclip: X11 剪贴板复制
	optdepends = bash: tbx-pkgbuild（「打包」域）跑的是 bash 脚本
	options = !debug
	source = toolbox-hub-0.1.0.tar.gz
	sha256sums = SKIP

pkgname = toolbox-hub
